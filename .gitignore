# Secrets and local environment
.env
.env.*
*.pfx
*.publishsettings

# Script output
# Get-DubberRecordings.ps1 writes recordings.json by default (DUBBER_OUT_FILE).
# Ignore that dump and any other local exports so API payloads stay out of git.
recordings.json
profile.json
output/
exports/

# Other generated data files. Source in this repo is the PowerShell scripts.
# To track a specific file later, add a negation rule, for example: !config.json
*.json
*.csv
*.xml
