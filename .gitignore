# PowerShell
# Session transcripts, history, and temporary files
*.log
*.tmp
*.temp
PowerShell_transcript*.txt
ConsoleHost_history.txt

# Module analysis cache and packaged modules
ModuleAnalysisCache
*.psm1.Cache
*.zip
*.nupkg

# Test and coverage output
TestResults/
coverage/
*.coverage
*.coveragexml

# Build output
[Bb]in/
[Oo]bj/

# User-specific and editor files
*.user
*.suo
.vs/
.idea/
curl.sh

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
